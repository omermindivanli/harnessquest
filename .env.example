# HarnessQuest Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =========================================================================
# LLM Provider API Keys (choose one or more)
# =========================================================================

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# NVIDIA NIM - https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Ollama (Local) - No API key needed, just run: ollama serve
# OLLAMA_BASE_URL=http://localhost:11434

# =========================================================================
# LiteLLM Proxy (Optional - for 100+ providers via unified gateway)
# =========================================================================
# LITELLM_MASTER_KEY=sk-your-litellm-master-key
# LITELLM_BASE_URL=http://localhost:4000

# =========================================================================
# Application Settings
# =========================================================================
DEFAULT_PROVIDER=litellm
DEFAULT_MODEL=gpt-4o-mini
MAX_TURNS=10
DEFAULT_TEMPERATURE=0.1
REQUEST_TIMEOUT=60

# =========================================================================
# Gamification Settings
# =========================================================================
XP_STORAGE_PATH=.harnessquest_xp.json
ENABLE_GAMIFICATION=true

# =========================================================================
# Sandbox Settings
# =========================================================================
SANDBOX_WORKSPACE=.
COMMAND_TIMEOUT=15

# =========================================================================
# Evaluation Settings
# =========================================================================
JUDGE_MODEL=gpt-4o-mini
JUDGE_PROVIDER=litellm

# =========================================================================
# Logging & Observability
# =========================================================================
LOG_LEVEL=INFO
ENABLE_TELEMETRY=false
# OTEL_ENDPOINT=http://localhost:4317